Algoritmo ej01_declaraciones
	// Declaración de variables
	Definir nombre Como Cadena
	Definir edad Como Entero
	Definir estatura Como Real
	Definir direccion Como Cadena
	// Inicialización de variables
	nombre <- ''
	edad <- 0
	estatura <- 0
	direccion <- ''
	// Lectura estandar
	Escribir 'Nombre:'
	Leer nombre
	Escribir 'Edad:'
	Leer edad
	Escribir 'Estatura:'
	Leer estatura
	Escribir 'Dirección:'
	Leer direccion
	// Resultado de los datos ingresados
	Escribir 'A continuación se muestran'
	Escribir 'los valores ingresados:'
	Escribir nombre
	Escribir edad
	Escribir estatura
	Escribir direccion
FinAlgoritmo
