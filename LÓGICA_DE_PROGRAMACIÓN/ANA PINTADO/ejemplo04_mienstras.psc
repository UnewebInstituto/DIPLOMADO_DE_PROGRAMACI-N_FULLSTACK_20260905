Algoritmo ejemplo04_mienstras
	//Declaracin de varibl 
	Definir i Como Entero
	//Inicializacion de variables
	i <- 0
	//Ejecucion o Proceso 
	mientras i< 5 Hacer
		escribir i // accion
		i<- i+1 //accion 
	FinMientras //cambio en valor en variable de control
	Escribir "fin del ciclo mienstras"

	
FinAlgoritmo 
