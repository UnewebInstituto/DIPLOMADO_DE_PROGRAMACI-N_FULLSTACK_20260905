Algoritmo ejemplo01_declaraciones
	// Declaracion de variables
	Definir nombre Como Cadena
	Definir edad Como Entero
	Definir estatura Como Real
	Definir direccion Como Cadena
	// Inilizacion de variables
	nombre <- ' '
	edad <- 0
	estatura <- 0
	direccion <- ' '
	// Lectura estandar
	Escribir 'Nombre'
	Leer nombre
	Escribir 'edad'
	Leer edad
	Escribir 'Estatura'
	Leer estatura
	Escribir 'direccion'
	Leer direccion
	// Resultado de los datos ingresados
	Escribir ' A continuacion se muestra'
	Escribir 'los valores ingresados'
	Escribir nombre
	Escribir edad
	Escribir estatura
	Escribir direccion
FinAlgoritmo
