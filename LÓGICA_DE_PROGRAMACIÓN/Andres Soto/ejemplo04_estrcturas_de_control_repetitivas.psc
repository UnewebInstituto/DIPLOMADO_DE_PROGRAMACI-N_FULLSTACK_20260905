Algoritmo ejemplo04_estrcturas_de_control_repetitivas
	// declaracion de variables
	Definir i Como Entero
	// inicializacion de variables
	i <- 0
	// ejecucion o Proceso
	Mientras i<5 Hacer
		Escribir i
		i <- i+1 // accion
	FinMientras // cambio en valor en variable de control
	
	Escribir 'fin del ciclo mientras'
FinAlgoritmo
