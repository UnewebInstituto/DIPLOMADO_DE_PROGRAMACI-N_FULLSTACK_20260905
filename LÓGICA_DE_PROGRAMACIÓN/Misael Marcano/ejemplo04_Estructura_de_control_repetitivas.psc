Algoritmo ejemplo04_Estructura_de_control_repetitivas
	// Declaraccion de variable
	Definir i Como Entero
	// inicializacion de variable
	i <- 0
	// ejeccucion o Proceso
	Mientras i<5 Hacer
		Escribir i
		i <- i+1 // accion
	FinMientras // Cambio de valor en la variable de control
	Escribir 'fin del ciclo'
FinAlgoritmo
